(version 1)
; Seatbelt profile for the repro sandbox: everything the model runs goes
; through this. The skeleton is the probe-4 profile — allow by default, then
; deny all network and every write but the run's clone and tmp, /dev/null, the
; command's own terminal and its fd devices — with these changes:
;   - no blanket write allow on /private/var/folders; the temp root and every
;     ancestor of the runs root stay unwritable (no rename, no replacement);
;   - no read of the operator's home (HOME) — but what the adapter's node
;     needs (NODE: its prefix, or under HOME only its bin, npm and corepack),
;     and the metadata of the directories from HOME down to it (NODEUP) — or of
;     the reviewed work tree (SRC), nor of the
;     fleet home (FLEET), the run's output dir (OUT), any
;     omelette-* dir under the OS temp root (TMPROOT) or any run (RUNS) but its
;     own clone and tmp, re-allowed last;
;   - no other terminal: no read or write of /dev/ttys*;
;   - no hand-off to a process outside the profile: Apple events, open,
;     osascript, launchctl, automator, security, pbpaste, pbcopy,
;     LaunchServices, launchd job creation, a preference write;
;   - no signal and no process info (argv, environment) outside its sandbox,
;     nor the process list through sysmond (pgrep, pkill);
;   - no file flag in the clone or tmp, no unlink, rename or replacement of the
;     clone and tmp directories themselves, no write under the clone's .vibe.
; The wrapper prefers the developer dir's binaries; the shims under /usr/bin
; keep no cache inside the sandbox.
(allow default)
(deny network*)
(deny file-write*)
(allow file-write*
  (subpath (param "CLONE"))
  (subpath (param "TMP"))
  (literal "/dev/null")
  (literal "/dev/tty")
  (regex #"^/dev/fd/"))
; no other terminal: the operator's ptys are neither read nor written
(deny file-read* (regex #"^/dev/ttys"))
(deny file-write* (regex #"^/dev/ttys"))
; the operator's home and the work tree under review: the clone is the only copy a command reads
(deny file-read* (subpath (param "HOME")))
; …but the metadata of the directories from HOME down to the node prefix's parent: node lstats each on its way to a script under it (npm in ~/.nvm); none is listable
(allow file-read-metadata (regex (param "NODEUP")))
; the node the adapter runs on stays runnable: its install prefix, or under HOME (~/.nvm) only its bin, npm and corepack — never the operator's other global packages
(allow file-read* (regex (param "NODE")))
(deny file-read* (subpath (param "SRC")))
(deny file-read* (subpath (param "FLEET")))
; a command must not hand work to a process outside this profile
(deny appleevent-send)
(deny process-exec (literal "/usr/bin/open") (literal "/usr/bin/osascript") (literal "/bin/launchctl") (literal "/usr/bin/automator") (literal "/usr/bin/security") (literal "/usr/bin/pbpaste") (literal "/usr/bin/pbcopy"))
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd") (global-name "com.apple.lsd.mapdb") (global-name "com.apple.lsd.modifydb"))
; pgrep and pkill get other processes' argv from the sysmond service (libsysmon), past the process-info deny below
(deny mach-lookup (global-name "com.apple.sysmond"))
(deny job-creation)
(deny user-preference-write)
; a command signals only processes of its own sandbox: not Vibe, not the operator's other processes
(deny signal)
(allow signal (target same-sandbox))
; nor reads another process's argv and environment
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
(deny process-info*)
(allow process-info* (target same-sandbox))
; the run's own output dir (export.json, session/meta.json, prompt.md) is Vibe's, not the model's
(deny file-read* (subpath (param "OUT")))
(deny file-write* (subpath (param "OUT")))
; the fleet's other temp dirs (every omelette-* under the OS temp root, another unit's included) are no command's either
(deny file-read* (regex (string-append "^" (param "TMPROOT") "/omelette-")))
(deny file-write* (regex (string-append "^" (param "TMPROOT") "/omelette-")))
; every run lives under RUNS: a command sees and writes its own clone and tmp (re-allowed last), never a sibling run's clone, tmp or out
(deny file-read* (subpath (param "RUNS")))
(deny file-write* (subpath (param "RUNS")))
; the path down to the run's own clone and tmp stays walkable (node and git lstat every component): RUNS and this run's dir, metadata only; listing stays denied, a sibling run dir is not even stat-able
(allow file-read-metadata (literal (param "RUNS")) (literal (param "RUN")))
(allow file-read* (subpath (param "CLONE")) (subpath (param "TMP")))
(allow file-write* (subpath (param "CLONE")) (subpath (param "TMP")))
; no immutable or append-only flag in the run's clone or tmp: the adapter must be able to remove the run
(deny file-write-flags (subpath (param "CLONE")) (subpath (param "TMP")))
; the clone and tmp directories themselves stay what the adapter made: a command may not unlink, rename or replace them (the adapter's git and chmod run on those paths)
(deny file-write-unlink (literal (param "CLONE")) (literal (param "TMP")))
; the clone's .vibe is the adapter's to drop, never the model's to write: Vibe ranks a project config over its home
(deny file-write* (subpath (string-append (param "CLONE") "/.vibe")))
